{
  "name": "ros-livekit-bridge",
  "build": {
    "context": "..",
    "dockerfile": "../Dockerfile",
    "args": {
      "WS_ROS": "livekit_ws"
    }
  },
  "workspaceFolder": "/livekit_ws",
  "workspaceMount": "source=${localWorkspaceFolder},target=/livekit_ws,type=bind",
  "remoteUser": "root",
  "init": true,
  "privileged": true,
  "runArgs": [
    "--ipc=host"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "QT_X11_NO_MITSHM": "1"
  },
  "postCreateCommand": "bash -lc 'source /opt/ros/jazzy/setup.bash && mkdir -p src/externals && if [ -f external.repos ]; then vcs import --skip-existing src/externals < external.repos; fi && rosdep update && rosdep install --from-paths src --ignore-src -r -y'",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "zsh",
        "terminal.integrated.profiles.linux": {
          "zsh": {
            "path": "/usr/bin/zsh"
          }
        }
      }
    }
  }
}
