<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>generic_sub_demo</name>
  <version>0.0.1</version>
  <description>
    Standalone demo: YAML-driven generic ROS 2 subscriptions that capture raw
    CDR-serialized bytes without compile-time message type knowledge.
  </description>
  <maintainer email="dev@livekit.io">LiveKit</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>yaml_cpp_vendor</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
