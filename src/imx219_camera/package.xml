<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>imx219_camera</name>
  <version>0.1.0</version>
  <description>
    Bringup for the Arducam IMX219 (CSI) camera on Raspberry Pi. Publishes
    sensor_msgs/msg/Image via the camera_ros libcamera node, with a small
    interposer that forces the libcamera IPA to load in-process in this
    container.
  </description>
  <maintainer email="stephen.derosa@livekit.io">Stephen DeRosa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>camera_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
