{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livekit.io/schemas/ros2_livekit_bridge_config.schema.json",
  "title": "ROS LiveKit Bridge Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["ros2_livekit_bridge"],
  "properties": {
    "ros2_livekit_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "room_name"],
      "properties": {
        "version": {
          "const": "0.0.1"
        },
        "room_name": {
          "$ref": "#/$defs/nonemptyString"
        },
        "topic_polling_period_ms": {
          "$ref": "#/$defs/positiveInteger",
          "default": 500
        },
        "ros_threads": {
          "$ref": "#/$defs/nonNegativeInteger",
          "default": 4
        },
        "room_options": {
          "$ref": "#/$defs/roomOptions"
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceConfig"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/topicConfig"
          }
        }
      }
    }
  },
  "$defs": {
    "direction": {
      "enum": ["in", "out", "bidirectional"]
    },
    "serviceDirection": {
      "enum": ["out"]
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "roomOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "join_retries": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "videoOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bitrate_kbps": {
          "$ref": "#/$defs/positiveInteger"
        },
        "codec": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "serviceConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "direction", "participant", "msg_type"],
      "properties": {
        "service": {
          "$ref": "#/$defs/nonemptyString"
        },
        "direction": {
          "$ref": "#/$defs/serviceDirection"
        },
        "participant": {
          "$ref": "#/$defs/nonemptyString"
        },
        "msg_type": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "topicConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "direction"],
      "properties": {
        "topic": {
          "$ref": "#/$defs/nonemptyString"
        },
        "direction": {
          "$ref": "#/$defs/direction"
        },
        "msg_type": {
          "description": "TEMPORARY STOPGAP (BOT-301): explicit ROS message type (e.g. 'nav_msgs/msg/OccupancyGrid') for an inbound LiveKit data track. LiveKit DataTracks do not yet carry ROS type metadata, so a pure consumer cannot infer the type of a track it only receives (nothing on its local ROS graph publishes it). Set this on 'in'/'bidirectional' topics so the bridge can create the republishing publisher. Remove once DataTracks propagate the ROS type.",
          "$ref": "#/$defs/nonemptyString"
        },
        "video_options": {
          "$ref": "#/$defs/videoOptions"
        }
      }
    }
  }
}
