{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://livekit.io/schemas/ros2_livekit_bridge_config.schema.json",
  "title": "ROS LiveKit Bridge Config",
  "type": "object",
  "additionalProperties": false,
  "required": ["ros2_livekit_bridge"],
  "properties": {
    "ros2_livekit_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "room_name"],
      "properties": {
        "version": {
          "const": "0.0.1"
        },
        "room_name": {
          "$ref": "#/$defs/nonemptyString"
        },
        "topic_polling_period_ms": {
          "$ref": "#/$defs/positiveInteger",
          "default": 500
        },
        "ros_threads": {
          "$ref": "#/$defs/nonNegativeInteger",
          "default": 4
        },
        "room_options": {
          "$ref": "#/$defs/roomOptions"
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/serviceConfig"
          }
        },
        "topics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/topicConfig"
          }
        }
      }
    }
  },
  "$defs": {
    "direction": {
      "enum": ["in", "out", "bidirectional"]
    },
    "serviceDirection": {
      "enum": ["out"]
    },
    "nonemptyString": {
      "type": "string",
      "minLength": 1
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "roomOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "join_retries": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "videoOptions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bitrate_kbps": {
          "$ref": "#/$defs/positiveInteger"
        },
        "codec": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "serviceConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "direction", "participant", "msg_type"],
      "properties": {
        "service": {
          "$ref": "#/$defs/nonemptyString"
        },
        "direction": {
          "$ref": "#/$defs/serviceDirection"
        },
        "participant": {
          "$ref": "#/$defs/nonemptyString"
        },
        "msg_type": {
          "$ref": "#/$defs/nonemptyString"
        }
      }
    },
    "topicConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "direction"],
      "properties": {
        "topic": {
          "$ref": "#/$defs/nonemptyString"
        },
        "direction": {
          "$ref": "#/$defs/direction"
        },
        "preserve_id": {
          "description": "Inbound topics only. When true, the publishing participant's (sanitized) identity is prepended to the republished ROS topic name, e.g. /tf from participant robot-1 becomes /robot_1/tf. Prevents topic-name collisions when multiple participants publish the same topic. Ignored for outbound topics.",
          "type": "boolean",
          "default": false
        },
        "max_rate_hz": {
          "description": "Outbound topics only. Optional cap (in Hz) on the rate at which this topic is forwarded to LiveKit, keeping unnecessary traffic off constrained links (e.g. throttle a high-rate /imu to a viewer-friendly rate for a remote consumer). Mirrors ros-tooling/topic_tools `throttle messages`: samples are forwarded on arrival, but any sample arriving less than one period (1 / max_rate_hz) after the last forwarded one is dropped. Only new samples are ever forwarded, so an idle topic is never re-sent and the cap is not a rate floor. This is lossy for topics whose messages each carry distinct content (e.g. /tf aggregates transforms from multiple broadcasters). Matched by literal topic name, not regex. Ignored for inbound topics.",
          "type": "number",
          "minimum": 0
        },
        "video_options": {
          "$ref": "#/$defs/videoOptions"
        }
      }
    }
  }
}
