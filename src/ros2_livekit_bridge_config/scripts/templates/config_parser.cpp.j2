BridgeConfig parseRoot(const YAML::Node & root)
{
  const std::string root_path(kRootPath);
  const std::string bridge_path = utils::fieldPath(root_path, {{ root_const }});

  utils::rejectUnknownFields(root, {std::string({{ root_const }})}, root_path);

  const auto bridge_node = root[{{ root_const }}.data()];
  if (!bridge_node) {
    utils::failMissing(bridge_path, "map");
  }
  return parseBridgeConfig(bridge_node, bridge_path);
}

