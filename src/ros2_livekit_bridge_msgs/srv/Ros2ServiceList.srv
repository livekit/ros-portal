string participant_id

# Set timeout to 0 so that by default we use LiveKits default
uint8 timeout_sec 0

# The rest of the fields are 1:1 with the field shown from running
# "ros2 service list --help"
bool show_types
bool count_services
bool include_hidden_services
---
bool success
string err_msg
string output
