/// @file
/// Versions this ROS Portal build was made with.
///
/// Generated by CMake from `cmake/version.hpp.in`; edit the template, never the
/// rendered header. Included as `ros_portal/version.hpp` by this package and by
/// downstream code, which may also preprocess against these macros.

#pragma once

/// ROS Portal package version components, from package.xml.
#define ROS_PORTAL_VERSION_MAJOR @ros_portal_VERSION_MAJOR@
#define ROS_PORTAL_VERSION_MINOR @ros_portal_VERSION_MINOR@
#define ROS_PORTAL_VERSION_PATCH @ros_portal_VERSION_PATCH@

/// ROS Portal package version as a string, for example `"0.1.0"`.
#define ROS_PORTAL_VERSION "@ros_portal_VERSION@"

/// Pack a `major.minor.patch` triple into a single comparable integer.
#define ROS_PORTAL_VERSION_ENCODE(major, minor, patch) (((major) * 1000000) + ((minor) * 1000) + (patch))

/// This build's version as a comparable integer.
#define ROS_PORTAL_VERSION_NUMBER                                                                                      \
  ROS_PORTAL_VERSION_ENCODE(ROS_PORTAL_VERSION_MAJOR, ROS_PORTAL_VERSION_MINOR, ROS_PORTAL_VERSION_PATCH)

/// True when this build is at least the given version, for `#if` guards in
/// downstream code that must support more than one ROS Portal release.
#define ROS_PORTAL_VERSION_AT_LEAST(major, minor, patch)                                                               \
  (ROS_PORTAL_VERSION_NUMBER >= ROS_PORTAL_VERSION_ENCODE(major, minor, patch))

/// LiveKit C++ SDK version this build links against.
///
/// Resolved by CMake from the SDK package that was actually found, so it
/// reflects `latest` resolution and source builds rather than the requested
/// `LIVEKIT_SDK_VERSION` pin. Recorded here because the SDK does not install a
/// `livekit/version.h` of its own; prefer that header once it ships one.
#define ROS_PORTAL_LIVEKIT_SDK_VERSION "@LIVEKIT_SDK_REPORTED_VERSION@"
