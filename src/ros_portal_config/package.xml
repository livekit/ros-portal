<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ros_portal_config</name>
  <version>0.1.0</version>
  <description>Schema-driven YAML configuration parser and config type definitions for ros_portal</description>
  <maintainer email="sderosa@livekit.io">sderosa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <buildtool_depend>ros2_medkit_cmake</buildtool_depend>

  <build_depend>python3-jinja2</build_depend>

  <depend>yaml_cpp_vendor</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
