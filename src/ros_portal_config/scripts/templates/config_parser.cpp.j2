{% macro field_parse(spec, field) %}
{%- set ns = namespace(lines=[]) %}
{%- if field.required %}
{%- set ns.lines = ns.lines + [required_field(spec, field)] %}
{%- else %}
{%- set path_expr = "utils::fieldPath(path, " ~ field.const_name ~ ")" %}
{%- set assignment = optional_assignment("value." ~ field.member_name, field.member_name, field.type_info, path_expr) %}
{%- set ns.lines = ns.lines + ["  if (const auto " ~ field.member_name ~ " = node[" ~ field.const_name ~ ".data()]) {"] %}
{%- set ns.lines = ns.lines + [assignment | indent(4, true)] %}
{%- set ns.lines = ns.lines + ["  }"] %}
{%- endif %}
{{- ns.lines | join("\n") -}}
{%- endmacro %}
{% macro required_field(spec, field) %}
{%- set ti = field.type_info %}
{%- set key = field.const_name %}
{%- set target = "value." ~ field.member_name %}
{%- set path_expr = "utils::fieldPath(path, " ~ key ~ ")" %}
{%- set ns = namespace(lines=[]) %}
{%- if ti.kind == "const_string" %}
{%- set cname = const_value_name(spec.cpp_name, field.yaml_name) %}
{%- set ns.lines = ns.lines + ["  " ~ target ~ " = requiredStringField(node, " ~ key ~ ", path, false);"] %}
{%- set ns.lines = ns.lines + ["  if (" ~ target ~ " != " ~ cname ~ ") {"] %}
{%- set ns.lines = ns.lines + ["    utils::fail("] %}
{%- set ns.lines = ns.lines + ["      " ~ path_expr ~ ", node[" ~ key ~ ".data()],"] %}
{%- set ns.lines = ns.lines + ["      std::string(\"'\") + std::string(" ~ cname ~ ") + \"'\","] %}
{%- set ns.lines = ns.lines + ["      \"found '\" + " ~ target ~ " + \"'\");"] %}
{%- set ns.lines = ns.lines + ["  }"] %}
{%- elif ti.kind == "string" %}
{%- set ns.lines = ns.lines + ["  " ~ target ~ " = requiredStringField("] %}
{%- set ns.lines = ns.lines + ["    node, " ~ key ~ ", path, " ~ cpp_bool(requires_nonempty(ti.schema)) ~ ");"] %}
{%- elif ti.kind == "integer" %}
{%- set ns.lines = ns.lines + ["  if (!node[" ~ key ~ ".data()]) {"] %}
{%- set ns.lines = ns.lines + ["    utils::failMissing(" ~ path_expr ~ ", \"" ~ integer_expected(ti.schema) ~ "\");"] %}
{%- set ns.lines = ns.lines + ["  }"] %}
{%- set ns.lines = ns.lines + ["  " ~ target ~ " = parseIntegerValue("] %}
{%- set ns.lines = ns.lines + ["    node[" ~ key ~ ".data()], " ~ path_expr ~ ", " ~ integer_minimum_args(ti.schema) ~ ");"] %}
{%- elif ti.kind == "number" %}
{%- set ns.lines = ns.lines + ["  if (!node[" ~ key ~ ".data()]) {"] %}
{%- set ns.lines = ns.lines + ["    utils::failMissing(" ~ path_expr ~ ", \"" ~ number_expected(ti.schema) ~ "\");"] %}
{%- set ns.lines = ns.lines + ["  }"] %}
{%- set ns.lines = ns.lines + ["  " ~ target ~ " = parseNumberValue("] %}
{%- set ns.lines = ns.lines + ["    node[" ~ key ~ ".data()], " ~ path_expr ~ ", " ~ number_minimum_args(ti.schema) ~ ");"] %}
{%- elif ti.kind == "boolean" %}
{%- set ns.lines = ns.lines + ["  if (!node[" ~ key ~ ".data()]) {"] %}
{%- set ns.lines = ns.lines + ["    utils::failMissing(" ~ path_expr ~ ", \"boolean\");"] %}
{%- set ns.lines = ns.lines + ["  }"] %}
{%- set ns.lines = ns.lines + ["  " ~ target ~ " = parseBooleanValue(node[" ~ key ~ ".data()], " ~ path_expr ~ ");"] %}
{%- elif ti.kind == "enum" %}
{%- set ns.lines = ns.lines + ["  " ~ target ~ " = required" ~ enum_cpp_name(ti) ~ "("] %}
{%- set ns.lines = ns.lines + ["    node[" ~ key ~ ".data()], " ~ path_expr ~ ", " ~ enum_allowed_values(ti) ~ ");"] %}
{%- elif ti.kind == "object" %}
{%- set ns.lines = ns.lines + ["  if (!node[" ~ key ~ ".data()]) {"] %}
{%- set ns.lines = ns.lines + ["    utils::failMissing(" ~ path_expr ~ ", \"map\");"] %}
{%- set ns.lines = ns.lines + ["  }"] %}
{%- set ns.lines = ns.lines + ["  " ~ target ~ " = parse" ~ ti.cpp_type ~ "(node[" ~ key ~ ".data()], " ~ path_expr ~ ");"] %}
{%- elif ti.kind == "array" %}
{%- set ns.lines = ns.lines + ["  if (!node[" ~ key ~ ".data()]) {"] %}
{%- set ns.lines = ns.lines + ["    utils::failMissing(" ~ path_expr ~ ", \"sequence\");"] %}
{%- set ns.lines = ns.lines + ["  }"] %}
{%- set ns.lines = ns.lines + [array_assignment(target, "node[" ~ key ~ ".data()]", ti, path_expr)] %}
{%- endif %}
{{- ns.lines | join("\n") -}}
{%- endmacro %}
{% macro optional_assignment(target, node_name, ti, path_expr) %}
{%- set ns = namespace(lines=[]) %}
{%- if ti.kind == "string" %}
{%- set ns.lines = ns.lines + [target ~ " = parseStringValue("] %}
{%- set ns.lines = ns.lines + ["  " ~ node_name ~ ", " ~ path_expr ~ ", " ~ cpp_bool(requires_nonempty(ti.schema)) ~ ");"] %}
{%- elif ti.kind == "integer" %}
{%- set ns.lines = ns.lines + [target ~ " = parseIntegerValue("] %}
{%- set ns.lines = ns.lines + ["  " ~ node_name ~ ", " ~ path_expr ~ ", " ~ integer_minimum_args(ti.schema) ~ ");"] %}
{%- elif ti.kind == "number" %}
{%- set ns.lines = ns.lines + [target ~ " = parseNumberValue("] %}
{%- set ns.lines = ns.lines + ["  " ~ node_name ~ ", " ~ path_expr ~ ", " ~ number_minimum_args(ti.schema) ~ ");"] %}
{%- elif ti.kind == "boolean" %}
{%- set ns.lines = ns.lines + [target ~ " = parseBooleanValue(" ~ node_name ~ ", " ~ path_expr ~ ");"] %}
{%- elif ti.kind == "enum" %}
{%- set ns.lines = ns.lines + [target ~ " = parse" ~ enum_cpp_name(ti) ~ "("] %}
{%- set ns.lines = ns.lines + ["  " ~ node_name ~ ", " ~ path_expr ~ ", " ~ enum_allowed_values(ti) ~ ");"] %}
{%- elif ti.kind == "object" %}
{%- set ns.lines = ns.lines + [target ~ " = parse" ~ ti.cpp_type ~ "(" ~ node_name ~ ", " ~ path_expr ~ ");"] %}
{%- elif ti.kind == "array" %}
{%- set ns.lines = ns.lines + [array_assignment(target, node_name, ti, path_expr)] %}
{%- endif %}
{{- ns.lines | join("\n") -}}
{%- endmacro %}
{% macro array_assignment(target, node_expr, ti, path_expr) %}
{%- set item = ti.array_item %}
{%- set ns = namespace(lines=[]) %}
{%- set ns.lines = ns.lines + ["utils::requireSequence(" ~ node_expr ~ ", " ~ path_expr ~ ");"] %}
{%- set ns.lines = ns.lines + [target ~ ".clear();"] %}
{%- set ns.lines = ns.lines + [target ~ ".reserve(" ~ node_expr ~ ".size());"] %}
{%- set ns.lines = ns.lines + ["for (std::size_t i = 0; i < " ~ node_expr ~ ".size(); ++i) {"] %}
{%- set ns.lines = ns.lines + ["  const auto item_path = " ~ path_expr ~ " + \"[\" + std::to_string(i) + \"]\";"] %}
{%- if item.kind == "object" %}
{%- set ns.lines = ns.lines + ["  " ~ target ~ ".push_back(parse" ~ item.cpp_type ~ "(" ~ node_expr ~ "[i], item_path));"] %}
{%- elif item.kind == "string" %}
{%- set ns.lines = ns.lines + ["  " ~ target ~ ".push_back(parseStringValue(" ~ node_expr ~ "[i], item_path, " ~ cpp_bool(requires_nonempty(item.schema)) ~ "));"] %}
{%- elif item.kind == "integer" %}
{%- set ns.lines = ns.lines + ["  " ~ target ~ ".push_back(parseIntegerValue(" ~ node_expr ~ "[i], item_path, " ~ integer_minimum_args(item.schema) ~ "));"] %}
{%- elif item.kind == "number" %}
{%- set ns.lines = ns.lines + ["  " ~ target ~ ".push_back(parseNumberValue(" ~ node_expr ~ "[i], item_path, " ~ number_minimum_args(item.schema) ~ "));"] %}
{%- elif item.kind == "boolean" %}
{%- set ns.lines = ns.lines + ["  " ~ target ~ ".push_back(parseBooleanValue(" ~ node_expr ~ "[i], item_path));"] %}
{%- elif item.kind == "enum" %}
{%- set ns.lines = ns.lines + ["  " ~ target ~ ".push_back(parse" ~ enum_cpp_name(item) ~ "(" ~ node_expr ~ "[i], item_path, " ~ enum_allowed_values(item) ~ "));"] %}
{%- endif %}
{%- set ns.lines = ns.lines + ["}"] %}
{{- ns.lines | join("\n") -}}
{%- endmacro %}
{{ prologue }}

