constexpr std::string_view kRootPath = "$";
{% for yaml_name, const_name in field_constants %}
constexpr std::string_view {{ const_name }} = "{{ yaml_name }}";
{% endfor %}
{% for const_name, const_value in const_values %}
constexpr std::string_view {{ const_name }} = "{{ const_value }}";
{% endfor %}
{% for enum in model.canonical_enums %}
{% for value in enum.values %}
constexpr std::string_view {{ enum_constant_name(enum, value) }} = "{{ value }}";
{% endfor %}
