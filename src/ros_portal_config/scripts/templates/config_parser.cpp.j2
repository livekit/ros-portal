{% for spec in all_specs %}
{{ spec.cpp_name }} {{ spec.parse_name }}(const YAML::Node & node, const std::string & path)
{
  utils::rejectUnknownFields(
    node,
    {{ allowed_field_set(spec) }},
    path);

  {{ spec.cpp_name }} value;
{% for field in spec.fields %}
{{ field_parse(spec, field) }}
{% endfor %}
  return value;
}

{% endfor %}
RosPortalConfig parseRoot(const YAML::Node & root)
{
  const std::string root_path(kRootPath);
  const std::string ros_portal_path = utils::fieldPath(root_path, {{ root_const }});

  utils::rejectUnknownFields(root, {{ root_allowed_field_set }}, root_path);

  const auto ros_portal_node = root[{{ root_const }}.data()];
  if (!ros_portal_node) {
    utils::failMissing(ros_portal_path, "map");
  }
  return parseRosPortalConfig(ros_portal_node, ros_portal_path);
}

} // namespace

RosPortalConfig ConfigParser::parseFile(const std::filesystem::path & path) const
{
  try {
    return parseRoot(YAML::LoadFile(path.string()));
  } catch (const YAML::Exception & e) {
    throw ConfigError(path.string(), "valid YAML config", e.what());
  }
}

RosPortalConfig ConfigParser::parseString(const std::string & yaml) const
{
  try {
    return parseRoot(YAML::Load(yaml));
  } catch (const YAML::Exception & e) {
    throw ConfigError("<string>", "valid YAML config", e.what());
  }
}

{% for enum in model.canonical_enums %}
const char * toString({{ enum.cpp_name }} value)
{
  switch (value) {
{% for enum_value in enum.values %}
    case {{ enum.cpp_name }}::{{ enum_value | enum_value_name }}:
      return {{ enum_constant_name(enum, enum_value) }}.data();
{% endfor %}
  }
  return "unknown";
}

