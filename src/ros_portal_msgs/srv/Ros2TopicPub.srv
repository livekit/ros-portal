string participant_id

# Set timeout to 0 so that by default we use ROS Portal default (ros2_cli::kDefaultTimeoutSec).
uint8 timeout_sec 0

# The rest of the fields map to a one-shot "ros2 topic pub" request.
# payload is the native YAML message argument accepted by "ros2 topic pub".
string topic
string msg_type
string payload
---
bool success
string err_msg
string output
