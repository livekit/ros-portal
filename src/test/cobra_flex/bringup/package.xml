<package format="3">
  <name>cobra_flex_bringup</name>
  <version>0.0.0</version>
  <description>Launch and configuration for the Cobra Flex physical stack.</description>
  <maintainer email="stephen.derosa@livekit.io">Stephen DeRosa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <exec_depend>cobra_flex_control</exec_depend>
  <exec_depend>cobra_flex_driver</exec_depend>
  <exec_depend>cobra_flex_localization</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
