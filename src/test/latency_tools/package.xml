<package format="3">
  <name>latency_tools</name>
  <version>0.1.0</version>
  <description>Trace capture, analysis, and visualization tools for ros_portal latency</description>
  <maintainer email="sderosa@livekit.io">sderosa</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>ros_portal</exec_depend>
  <exec_depend>ros2topic</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tracetools_launch</exec_depend>
  <exec_depend>tracetools_read</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
