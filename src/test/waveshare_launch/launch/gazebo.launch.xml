<launch>
    <arg name="use_sim_time" default="true" />
    <arg name="model" default="$(find-pkg-share waver_description)/urdf/waver.xacro" />
    <arg name="camera_type" default="raspi" description="Xacro camera variant (raspi/depth)." />
    <arg name="world_file" default="$(find-pkg-share waver_gazebo)/worlds/room.sdf" />
    <arg name="gui" default="false" description="Launch the Gazebo GUI client." />

    <!-- Per-robot TF frame prefix. Must match waveshare.launch.xml / slam so the
         whole sim TF tree lives under "<robot_name>/" and several sim robots can
         share one viewer's /tf without frame collisions. -->
    <arg name="robot_name" default="robot_1" description="Per-robot TF frame prefix." />

    <!-- ============================ Robot description ============================ -->
    <!-- Run robot_state_publisher directly (rather than including
         waver_description/description.launch.xml) so we can set frame_prefix:
         the vendored launch does not expose it, and that tree is re-imported by
         vcs so patching it there would not persist. frame_prefix prepends
         "<robot_name>/" to every URDF-derived frame (base_link -> robot_1/base_link,
         lidar_link -> robot_1/lidar_link, ...), matching the real-robot path.

         Note: Gazebo-emitted frames are NOT covered by frame_prefix (the
         DiffDrive plugin's odom->base_footprint and the lidar's scan frame are
         baked into the vendored URDF); those are prefixed by
         sim_frame_prefix_relay below.

         No joint_state_publisher here: the Gazebo JointStatePublisher plugin
         already publishes /joint_states, and a second publisher would fight it
         with zeroed joint positions. -->
    <node name="robot_state_publisher" pkg="robot_state_publisher" exec="robot_state_publisher" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)" />
        <param name="frame_prefix" value="$(var robot_name)/" />
        <param name="robot_description"
            value="$(command 'xacro $(var model) sim_control:=gazebo camera_type:=$(var camera_type)')" />
    </node>

    <include if="$(var gui)" file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="-r -v 4 $(var world_file)" />
    </include>

    <include unless="$(var gui)" file="$(find-pkg-share ros_gz_sim)/launch/gz_sim.launch.py">
        <arg name="gz_args" value="-r -s -v 4 $(var world_file)" />
    </include>

    <node pkg="ros_gz_sim" exec="create" name="spawn_waver"
        args="-name waver -topic robot_description" output="screen">
    </node>

    <!-- Bridge Gazebo topics to ROS. /tf and /scan are remapped to raw /sim/*
         topics so sim_frame_prefix_relay can rewrite their frame_ids to the
         "<robot_name>/" prefix before republishing them on the canonical
         /tf and /scan. All other topics pass through unchanged. -->
    <node pkg="ros_gz_bridge" exec="parameter_bridge" name="gz_bridge" output="screen"
        args="--ros-args -p config_file:=$(find-pkg-share waver_gazebo)/config/ros_gz_bridge.yaml">
        <remap from="/tf" to="/sim/tf" />
        <remap from="/scan" to="/sim/scan" />
    </node>

    <!-- Prefix Gazebo-emitted frames: /sim/tf -> /tf and /sim/scan -> /scan with
         every frame_id prepended with "<robot_name>/". This connects the
         DiffDrive odom->base_footprint TF and the lidar scan frame into the
         prefixed URDF tree published by robot_state_publisher, so slam_toolbox
         (whose frames slam.launch.py rewrites to the same prefix) has a
         complete TF chain: <robot_name>/map -> odom -> base_footprint -> ... -> lidar_link. -->
    <node pkg="waveshare_launch" exec="sim_frame_prefix_relay.py" name="sim_frame_prefix_relay" output="screen">
        <param name="use_sim_time" value="$(var use_sim_time)" />
        <param name="prefix" value="$(var robot_name)/" />
        <param name="input_tf_topic" value="/sim/tf" />
        <param name="output_tf_topic" value="/tf" />
        <param name="input_scan_topic" value="/sim/scan" />
        <param name="output_scan_topic" value="/scan" />
    </node>

</launch>
