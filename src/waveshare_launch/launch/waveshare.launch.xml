<launch>
  <arg name="sim" default="false" description="Launch Gazebo and use simulation settings." />
  <arg name="rviz" default="false" description="Launch RViz alongside the robot stack." />
  <arg name="sim_gui" default="false" description="Launch the Gazebo GUI client when sim is enabled." />
  <arg name="foxglove" default="false" description="Launch the Foxglove bridge with default settings." />
  <arg name="livekit" default="true" description="Launch the ROS 2 LiveKit bridge." />
  <arg name="livekit_config" default="$(find-pkg-share ros2_livekit_bridge)/config/ros2_livekit_bridge.yaml" description="Config file for the ROS 2 LiveKit bridge." />

  <include unless="$(var sim)" file="$(find-pkg-share waver_description)/launch/description.launch.xml">
    <arg name="use_sim_time" value="false" />
    <arg name="sim_control" value="ros2" />
  </include>

  <include if="$(var sim)" file="$(find-pkg-share nav2_bringup)/launch/navigation_launch.py">
    <arg name="use_sim_time" value="true" />
  </include>

  <include unless="$(var sim)" file="$(find-pkg-share nav2_bringup)/launch/navigation_launch.py">
    <arg name="use_sim_time" value="false" />
  </include>

  <include if="$(var sim)" file="$(find-pkg-share waver_nav)/launch/online_async.launch.xml">
    <arg name="use_sim_time" value="true" />
  </include>

  <include unless="$(var sim)" file="$(find-pkg-share waver_nav)/launch/online_async.launch.xml">
    <arg name="use_sim_time" value="false" />
  </include>

  <include if="$(var sim)" file="$(find-pkg-share waveshare_launch)/launch/gazebo.launch.xml">
    <arg name="use_sim_time" value="true" />
    <arg name="gui" value="$(var sim_gui)" />
  </include>

  <group if="$(var rviz)">
    <include if="$(var sim)" file="$(find-pkg-share waver_viz)/launch/rviz.launch.xml">
      <arg name="use_sim_time" value="true" />
    </include>

    <include unless="$(var sim)" file="$(find-pkg-share waver_viz)/launch/rviz.launch.xml">
      <arg name="use_sim_time" value="false" />
    </include>
  </group>

  <include if="$(var foxglove)" file="$(find-pkg-share foxglove_bridge)/launch/foxglove_bridge_launch.xml" />

  <include if="$(var livekit)" file="$(find-pkg-share ros2_livekit_bridge)/launch/livekit_bridge.launch.xml">
    <arg name="config" value="$(var livekit_config)" />
  </include>
</launch>
