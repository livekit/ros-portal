<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>waveshare_launch</name>
  <version>0.0.0</version>
  <description>A launch package for launching gazebo, rviz, controllers, etc for the waveshare robot</description>
  <maintainer email="stephen.derosa@livekit.io">Stephen DeRosa</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>foxglove_bridge</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>waver_description</exec_depend>
  <exec_depend>waver_gazebo</exec_depend>
  <exec_depend>waver_nav</exec_depend>
  <exec_depend>waver_viz</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
